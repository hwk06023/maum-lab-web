# No dependency installation or API key is needed for the demo.
HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://localhost:3000
LLM_MODE=demo
# Optional live model mode. Copy to .env.local, never commit real credentials.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Live mode requires this access code AND per-session AI processing consent.
PILOT_ACCESS_CODE=
# Per-process safeguards, not a distributed rate limiter.
MAX_SESSIONS=100
MAX_LLM_CALLS_PER_HOUR=100

# Vercel only; server-side variables, never NEXT_PUBLIC_*.
MAUM_BACKEND_URL=
MAUM_PROXY_SECRET=
